{
  "name": "firstrole",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test:database": "node tests/database-check.mjs",
    "check": "npm run typecheck && npm run test && npm run test:database && npm run build",
    "dev:ui-test": "vite --host 127.0.0.1 --mode ui-test --port 5174"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.1"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
