# Copy to .dev.vars for local development. Never commit .dev.vars or real keys.
# Use the free Cloudflare Workers plan and Supabase free project.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
GUEST_COOKIE_SECRET=""
APP_ORIGIN="http://localhost:8787"
TINYFISH_API_KEY=""
TINYFISH_ENABLED="false"
TINYFISH_OUTPUT_SCHEMA_ENABLED="false"
TINYFISH_MAX_STEPS_ENABLED="false"
TINYFISH_REPORTED_USAGE_ENABLED="true"
# Optional initial manual proof; runtime wallet metadata verifies rates automatically
# when unset. Private automatic proofs last six hours and never reset the pilot budget.
# A manual UTC timestamp is valid for at most 24 hours and requires the current
# API key's SHA-256 below. Never put the API key itself in the fingerprint field.
TINYFISH_RATES_VERIFIED_AT=""
TINYFISH_RATES_KEY_SHA256=""
TINYFISH_AGENT_RATE="0.016"
TINYFISH_SEARCH_RATE="0.005"
TINYFISH_FETCH_RATE="0.001"
GOOGLE_AUTH_ENABLED="false"
# Optional helpers. TinyFish remains the discovery/read/interaction provider.
OPENROUTER_ENABLED="false"
OPENROUTER_API_KEY=""
OPENROUTER_PROVIDER="nextbit/bf16"
FIRECRAWL_ENABLED="false"
FIRECRAWL_API_KEY=""
# Check the Firecrawl account is Free with no automatic purchases. The attestation
# is key-bound and expires after 30 days; runtime also checks the free-sized allowance.
FIRECRAWL_FREE_PLAN_VERIFIED_AT=""
FIRECRAWL_FREE_PLAN_KEY_SHA256=""
